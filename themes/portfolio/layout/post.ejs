<article class="section post">
  <div class="container container-narrow">
    <div class="post-head">
      <div class="section-no mono">#</div>
      <h1 class="post-title"><%= page.title %></h1>
      <div class="post-meta mono">
        <span><%- date(page.date, 'YYYY-MM-DD') %></span>
        <% if (page.categories && page.categories.length) { %>
          <span><%= page.categories.map(function(c){ return c.name; }).join(' / ') %></span>
        <% } %>
        <% if (page.tags && page.tags.length) { %>
          <span><%= page.tags.map(function(t){ return '#' + t.name; }).join(' ') %></span>
        <% } %>
      </div>
    </div>
    <div class="post-body"><%- page.content %></div>
  </div>
</article>
