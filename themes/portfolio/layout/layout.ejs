<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title && page.title !== 'index' ? page.title + ' · ' : '' %><%= theme.name %> · <%= theme.title %></title>
  <meta name="description" content="<%= theme.name %>（<%= theme.en_name %>）— <%= theme.title %>，专注 LLM Agent、RAG 与知识图谱工程化。">
  <meta name="theme-color" content="#4f46e5">
  <link rel="stylesheet" href="<%- url_for('css/style.css') %>">
</head>
<body>

<header class="nav" id="top">
  <div class="container nav-inner">
    <a href="<%- url_for('/') %>" class="nav-brand">
      <span class="brand-mark">◈</span>
      <span class="brand-name"><%= theme.name %></span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      <a href="#about">关于</a>
      <a href="#skills">技能</a>
      <a href="#projects">项目</a>
      <a href="#repos">仓库</a>
      <a href="#experience">经验</a>
      <a href="#awards">荣誉</a>
      <a href="#education">教育</a>
      <a href="#contact">联系</a>
    </nav>
    <a class="nav-cta" href="<%- url_for('resume.pdf') %>" target="_blank" rel="noopener">简历 PDF ↗</a>
  </div>
</header>

<main><%- body %></main>

<footer class="footer" id="contact">
  <div class="container footer-inner">
    <div class="footer-head">
      <div>
        <div class="footer-name"><%= theme.name %> <span class="mono muted">/ <%= theme.en_name %></span></div>
        <div class="footer-title"><%= theme.title %> · <%= theme.en_title %></div>
      </div>
      <div class="footer-tag">开放机会 · 一个月内到岗</div>
    </div>

    <div class="footer-grid">
      <a class="footer-item" href="mailto:<%= theme.email %>">
        <span class="footer-item-icon">✉</span>
        <span class="footer-item-label">邮箱</span>
        <span class="footer-item-value mono"><%= theme.email %></span>
      </a>
      <a class="footer-item" href="tel:<%= theme.phone %>">
        <span class="footer-item-icon">☎</span>
        <span class="footer-item-label">电话 / 微信</span>
        <span class="footer-item-value mono"><%= theme.phone %></span>
      </a>
      <a class="footer-item" href="<%= theme.github %>" target="_blank" rel="noopener">
        <span class="footer-item-icon">⌥</span>
        <span class="footer-item-label">GitHub</span>
        <span class="footer-item-value mono">@evanshao408</span>
      </a>
      <a class="footer-item" href="<%= theme.csdn %>" target="_blank" rel="noopener">
        <span class="footer-item-icon">▤</span>
        <span class="footer-item-label">CSDN 博客</span>
        <span class="footer-item-value mono">7 年码龄</span>
      </a>
    </div>

    <div class="footer-bottom">
      <span>© 2026 <%= theme.name %> · 用 Hexo 构建</span>
      <span class="mono muted">$ echo "thanks for visiting"</span>
    </div>
  </div>
</footer>

<script src="<%- url_for('js/main.js') %>"></script>
</body>
</html>
