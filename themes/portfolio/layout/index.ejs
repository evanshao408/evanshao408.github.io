<!-- ============ HERO ============ -->
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-main">
      <div class="hero-badge mono">
        <span class="pulse"></span> 在职 · 一个月内到岗
      </div>
      <h1 class="hero-name"><%= theme.name %></h1>
      <div class="hero-sub">
        <span class="hero-title"><%= theme.title %></span>
        <span class="hero-title-en mono"><%= theme.en_title %></span>
      </div>
      <p class="hero-desc">
        专注 <strong>LLM Agent</strong>、<strong>RAG</strong> 与 <strong>知识图谱</strong>工程化的算法工程师，
        从算法竞赛一路走到工业级大模型项目落地。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">查看项目 ↓</a>
        <a class="btn btn-ghost" href="<%- url_for('resume.pdf') %>" target="_blank" rel="noopener">下载简历 PDF</a>
      </div>
      <div class="hero-meta mono">
        <a href="mailto:<%= theme.email %>">✉ <%= theme.email %></a>
        <a href="<%= theme.github %>" target="_blank" rel="noopener">⌥ github/evanshao408</a>
        <a href="<%= theme.csdn %>" target="_blank" rel="noopener">▤ CSDN</a>
      </div>
    </div>

    <div class="hero-terminal" aria-hidden="true">
      <div class="terminal">
        <div class="terminal-bar">
          <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
          <span class="terminal-title mono">shao-yuyuan — zsh</span>
        </div>
        <div class="terminal-body mono">
          <div class="tline"><span class="tprompt">~/portfolio $</span> <span class="tcmd">whoami</span></div>
          <div class="tline tout">Shao Yuyuan · LLM Algorithm Engineer</div>
          <div class="tline"><span class="tprompt">~/portfolio $</span> <span class="tcmd">cat focus.txt</span></div>
          <div class="tline tout">Agent · RAG · Knowledge Graph · Engineering</div>
          <div class="tline"><span class="tprompt">~/portfolio $</span> <span class="tcmd">ls repos/</span></div>
          <div class="tline tout">copilot-agent/  knowledge-base/  vision-system/<span class="cursor">█</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="container hero-stats">
    <div class="stat">
      <div class="stat-num">3<span class="accent">年</span></div>
      <div class="stat-label">大模型工程经验</div>
    </div>
    <div class="stat">
      <div class="stat-num">22<span class="accent">/22</span></div>
      <div class="stat-label">黄金路径测试通过</div>
    </div>
    <div class="stat">
      <div class="stat-num">25.6<span class="accent">k</span></div>
      <div class="stat-label">知识图谱节点</div>
    </div>
    <div class="stat">
      <div class="stat-num">5<span class="accent">项</span></div>
      <div class="stat-label">算法竞赛国奖</div>
    </div>
  </div>
</section>

